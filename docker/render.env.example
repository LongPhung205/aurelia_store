# ==============================================================================
# Aurelia Store - Render Production Environment Variables Template
# ==============================================================================
# Copy toàn bộ mẫu này và điền thông tin thực tế của bạn khi cấu hình:
# Render Dashboard > Web Service > Environment > "Add from .env"
# ==============================================================================

# --- Cấu hình ứng dụng cơ bản ---
APP_NAME="Aurelia Store"
APP_ENV=production
APP_KEY=base64:your_generated_app_key_here
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com
PORT=10000

# --- Logging ---
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Cơ sở dữ liệu Aiven MySQL Cloud ---
DB_CONNECTION=mysql
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=your_mysql_port
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_database_password
# Đường dẫn file chứng chỉ CA mà entrypoint sẽ tự động mount:
MYSQL_ATTR_SSL_CA=/run/app-certificates/mysql-ca.pem

# --- Tự động chạy Migration & Tạo Admin ---
RUN_MIGRATIONS=true
RUN_SEEDERS=false

# --- Tài khoản Admin khởi tạo ---
SEED_ADMIN_NAME="Aurelia Admin"
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=YourStrongAdminPassword123!

# --- Session & Cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Gửi Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Aurelia Store"

# --- Cổng thanh toán PayOS ---
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# --- Cổng thanh toán MoMo ---
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_VERIFY_SSL=true
MOMO_RETURN_URL=https://your-service-name.onrender.com/payment/momo/return
MOMO_NOTIFY_URL=https://your-service-name.onrender.com/payment/momo/notify

# --- Giao Hàng Nhanh (GHN) API ---
GHN_API_URL=https://online-gateway.ghn.vn/shiip/public-api/
GHN_TOKEN=your_ghn_api_token
GHN_SHOP_ID=your_ghn_shop_id
GHN_FROM_DISTRICT_ID=your_from_district_id
GHN_FROM_WARD_CODE=your_from_ward_code

# --- Real-time Chat (Laravel Reverb WebSocket) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=895058
REVERB_APP_KEY=your_reverb_app_key
REVERB_APP_SECRET=your_reverb_app_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="your-service-name.onrender.com"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME="https"
