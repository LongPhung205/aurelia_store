# ==============================================================================
# Aurelia Store - Render Environment Variables Reference
# ==============================================================================
# Paste these variables into your Render Web Service > Environment Dashboard.
# NOTE: Do NOT commit actual secrets or production passwords to Git.
# ==============================================================================

# --- Application Configuration ---
APP_NAME="Aurelia Store"
APP_ENV=production
APP_DEBUG=false
# Replace with your actual Render Web Service URL (e.g., https://aurelia-store.onrender.com)
APP_URL=https://aurelia-store.onrender.com
# Generate via: php artisan key:generate --show
APP_KEY=base64:YOUR_APP_KEY_HERE
# Render injects PORT automatically (defaults to 10000)
PORT=10000

# --- Logging & Maintenance ---
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (Aiven MySQL with SSL) ---
DB_CONNECTION=mysql
DB_HOST=mysql-xxxx-your-service.a.aivencloud.com
DB_PORT=25060
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=YOUR_AIVEN_PASSWORD_HERE
# Path where entrypoint installs the Aiven CA Certificate:
MYSQL_ATTR_SSL_CA=/run/app-certificates/mysql-ca.pem

# --- Deployment Automation Flags ---
# Set to true during initial deployment or when running schema updates
RUN_MIGRATIONS=true
# Set to true on first deployment to seed the initial secure admin user
RUN_SEEDERS=true

# --- Secure Admin User Seeding (Task 1) ---
SEED_ADMIN_NAME="Aurelia Administrator"
SEED_ADMIN_EMAIL=admin@aureliastore.com
# Password must be at least 12 characters long:
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS

# --- Sessions & Cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=database

# --- PayOS Payment Gateway ---
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# --- Giao Hang Nhanh (GHN) API ---
GHN_API_TOKEN=your_ghn_api_token
GHN_SHOP_ID=your_ghn_shop_id
GHN_CLIENT_ID=your_ghn_client_id

# --- Mail Configuration (Optional / SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@aureliastore.com"
MAIL_FROM_NAME="Aurelia Store"
